{
  "name": "janepu-watermark-studio",
  "version": "0.3.0",
  "description": "Privacy-first, offline batch watermark studio with custom logos and reusable templates",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": {
    "name": "JANEPU",
    "email": "info@janepu.com"
  },
  "homepage": "https://janepu.com",
  "desktopName": "com.janepu.watermarkstudio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuvKab/janepu-watermark-studio.git"
  },
  "keywords": ["watermark", "electron", "offline", "batch", "privacy"],
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:zip": "npm run build && electron-builder --win zip",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.janepu.watermarkstudio",
    "productName": "简普水印工作室",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/@fontsource-variable/inter/LICENSE",
        "to": "licenses/Inter-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/cormorant-garamond/LICENSE",
        "to": "licenses/Cormorant-Garamond-OFL.txt"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "syncDesktopName": true,
      "maintainer": "JANEPU <info@janepu.com>",
      "artifactName": "janepu-watermark-studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "janepu-watermark-studio-setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.graphics-design",
      "artifactName": "janepu-watermark-studio-${version}-${arch}.${ext}"
    }
  }
}
